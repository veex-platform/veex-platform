vdlVersion: "1.0"
environment:
  target: "esp32"
capabilities:
  - "comm.can"
  - "comm.mqtt"

flows:
  bridge:
    steps:
      - name: "read_can"
        capability: "comm.can"
        action: "read"
        params: { id: 0x123 }

      - name: "push_to_cloud"
        capability: "comm.mqtt"
        action: "publish"
        params: { topic: "v1/industrial/can/raw", payload: "$DATA" }
