vdlVersion: "1.0"
environment:
  target: "esp32"
capabilities:
  - "comm.mqtt"
  - "platform.gpio"

flows:
  command_listener:
    steps:
      - name: "wait_for_cmd"
        capability: "comm.mqtt"
        action: "subscribe"
        params: { topic: "v1/device/veex/control/+", timeout: 0 }

      - name: "process_command"
        capability: "platform.gpio"
        action: "write"
        params: { pin: 2, level: "$PAYLOAD" }

      - name: "confirm_action"
        capability: "comm.mqtt"
        action: "publish"
        params: { topic: "v1/device/veex/control/ack", payload: "DONE" }
